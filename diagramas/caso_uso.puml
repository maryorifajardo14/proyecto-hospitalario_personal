@startuml caso_uso
' =====================================================================
' Diagrama de Casos de Uso
' Modulo: Expediente medico electronico base
' Proceso: Apertura y consulta autorizada del expediente longitudinal
' Estudiante: Maryori Rachael Fajardo Paredes
' =====================================================================
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F2F7FC
  BorderColor #2C5C8A
}
skinparam actorStyle awesome

actor "Personal Clinico\nAutorizado\n(Medico / Enfermeria)" as Medico
actor "Servicio de\nAutenticacion" as Auth <<sistema>>
actor "Servicio de\nAutorizacion RBAC" as RBAC <<sistema>>
actor "Modulo de\nAuditoria" as Auditoria <<sistema>>

rectangle "Sistema HIS - Modulo de Expediente Medico Electronico" {
  usecase "UC1: Solicitar apertura y\nconsulta del expediente\nlongitudinal" as UC1
  usecase "UC2: Autenticar sesion\n(validar token vigente)" as UC2
  usecase "UC3: Verificar autorizacion\n(RBAC por rol y tenant)" as UC3
  usecase "UC4: Consolidar historial\nlongitudinal del paciente" as UC4
  usecase "UC5: Registrar evento\nde auditoria" as UC5
  usecase "UC6: Denegar acceso\nno autorizado" as UC6
  usecase "UC7: Notificar paciente\ninexistente en el tenant" as UC7
}

Medico --> UC1

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>

UC6 ..> UC3 : <<extend>>
UC7 ..> UC4 : <<extend>>
UC6 ..> UC5 : <<include>>
UC7 ..> UC5 : <<include>>

UC2 -- Auth
UC3 -- RBAC
UC5 -- Auditoria

note right of UC1
  <b>Objetivo del proceso</b>
  Permitir que personal clinico autorizado
  abra y consulte el expediente longitudinal
  de un paciente dentro de su tenant,
  garantizando autenticacion vigente,
  autorizacion por rol y trazabilidad
  completa (exitosa o denegada) del acceso.
end note

note bottom of UC6
  Alternativa cuando el rol del
  usuario no tiene permiso sobre
  el recurso "expediente" en el tenant.
end note

note bottom of UC7
  Alternativa cuando el paciente
  solicitado no existe en el tenant
  del usuario autenticado.
end note

@enduml
