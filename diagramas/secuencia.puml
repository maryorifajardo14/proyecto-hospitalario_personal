@startuml secuencia
' =====================================================================
' Diagrama de Secuencia
' Modulo: Expediente medico electronico base
' Proceso: Apertura y consulta autorizada del expediente longitudinal
' Estudiante: Maryori Rachael Fajardo Paredes
' =====================================================================
skinparam sequence {
  ArrowColor #2C5C8A
  ActorBorderColor #2C5C8A
  LifeLineBorderColor #8A9BB0
  ParticipantBackgroundColor #F2F7FC
  ParticipantBorderColor #2C5C8A
}

actor "Personal Clinico\nAutorizado" as Medico
participant "UI Expediente\n(Frontend SPA)" as UI
participant "ExpedienteController\n(API)" as API
participant "AuthService\n(JWT)" as Auth
participant "RBACService" as RBAC
participant "ExpedienteService" as Svc
participant "AuditService" as Audit
database "Base de Datos" as DB

Medico -> UI : seleccionar paciente y solicitar\napertura de expediente
activate UI
UI -> API : GET /pacientes/{id}/expediente\n(Authorization: Bearer token)
activate API

API -> Auth : validarToken(token)
activate Auth
Auth --> API : resultado(tokenValido, usuario, tenantId)
deactivate Auth

alt Token invalido o expirado
  API --> UI : 401 No autorizado
  UI --> Medico : "Sesion expirada, inicie sesion nuevamente"
else Token valido
  API -> RBAC : verificarPermiso(usuario, rol,\nrecurso="expediente", tenantId)
  activate RBAC
  RBAC --> API : resultado(autorizado: boolean)
  deactivate RBAC

  alt No autorizado
    API -> Audit : registrarEvento("ACCESO_DENEGADO",\nusuario, pacienteId, timestamp)
    activate Audit
    Audit --> API : ack
    deactivate Audit
    API --> UI : 403 Acceso denegado
    UI --> Medico : "No tiene permisos para\nconsultar este expediente"
  else Autorizado
    API -> Svc : obtenerExpedienteLongitudinal(pacienteId, tenantId)
    activate Svc
    Svc -> DB : SELECT paciente, notasSOAP,\ndiagnosticos, alergias, signosVitales,\nlabs, prescripciones WHERE paciente=id\nAND tenant=tenantId
    activate DB
    DB --> Svc : resultset
    deactivate DB

    alt Paciente no encontrado
      Svc --> API : notFound
      API -> Audit : registrarEvento("PACIENTE_NO_ENCONTRADO",\nusuario, pacienteId, timestamp)
      activate Audit
      Audit --> API : ack
      deactivate Audit
      API --> UI : 404 Paciente no encontrado
      UI --> Medico : "Paciente no encontrado en el tenant"
    else Paciente encontrado
      Svc --> API : expedienteConsolidado
      deactivate Svc
      API -> Audit : registrarEvento("ACCESO_CONCEDIDO",\nusuario, pacienteId, timestamp)
      activate Audit
      Audit --> API : ack
      deactivate Audit
      API --> UI : 200 OK + expedienteLongitudinal
      UI --> Medico : mostrar expediente\nlongitudinal consolidado
    end
  end
end
deactivate API
deactivate UI

@enduml
